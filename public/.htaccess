<IfModule mod_rewrite.c>
Options +FollowSymLinks -MultiViews
RewriteEngine On

# Pentagon static HTML + PHP backend (cPanel / Ampps)
# Real files (index.html, contact-us/, wp-content/, etc.) are served first.

# PHP app pretty URLs (admin, auth, courses PHP pages)
RewriteRule ^login/?$ auth/login.php [L]
RewriteRule ^forgot-password/?$ auth/forgot_password.php [L]
RewriteRule ^reset-password/?$ auth/reset_password.php [L]
RewriteRule ^testimonials/submit/?$ testimonials/submit.php [L]
RewriteRule ^apply/?$ apply/index.php [L]
RewriteRule ^courses/?$ courses/index.php [L]
RewriteRule ^about/?$ about/index.php [L]
RewriteRule ^contact/?$ contact/index.php [L]
RewriteRule ^projects/?$ projects/index.php [L]
RewriteRule ^blog/?$ blogs/index.php [L]

# API — always PHP
RewriteRule ^api/ - [L]

# Existing files and directories (HTML, CSS, images, admin/, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Homepage: prefer Pentagon index.html, fall back to PHP
DirectoryIndex index.html index.php
RewriteRule ^$ index.html [L]
RewriteRule ^ index.php [L]
</IfModule>

# Block direct access to app source if deployed inside web root
<IfModule mod_authz_core.c>
  <If "%{REQUEST_URI} =~ m#^/app/#">
    Require all denied
  </If>
</IfModule>
