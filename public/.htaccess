# Dazu Hub Institute — Apache (optional)
# WEB_ROOT is auto-detected: works on Ampps (/Registration-System/public/...)
# and cPanel when public/ is the document root (no prefix needed).
#
# Only uncomment on cPanel IF links/assets still show the wrong prefix:
# SetEnv APP_WEB_ROOT ""

<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>
