RewriteEngine On

# Redirect /page/index.php → /page (canonical clean URLs)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{THE_REQUEST} \s[^\s?]*/index\.php[\s?] [NC]
RewriteRule ^index\.php$ ./ [R=301,L]
RewriteRule ^(.*)index\.php$ $1 [R=301,L]

# Pretty URLs → PHP handlers
RewriteRule ^login/?$ auth/login.php [L]
RewriteRule ^apply/?$ apply/index.php [L]
RewriteRule ^courses/?$ courses/index.php [L]
RewriteRule ^about/?$ about/index.php [L]
RewriteRule ^contact/?$ contact/index.php [L]
RewriteRule ^projects/?$ projects/index.php [L]
RewriteRule ^blog/?$ blogs/index.php [L]

DirectoryIndex index.php

# Serve existing files and directories (api, admin, uploads, assets, PHP pages)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Homepage fallback
RewriteRule ^ index.php [L]
