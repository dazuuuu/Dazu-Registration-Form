# Optional overrides for `npm run dev` (copy to .env.local)
# Defaults are /Registration-System/public — change if your Ampps folder differs
# VITE_API_PROXY_TARGET=http://127.0.0.1
# VITE_API_PROXY_BASE=/Registration-System/public
#
# Production build override (usually auto-detected from URL):
# VITE_API_BASE=/Registration-System/public
