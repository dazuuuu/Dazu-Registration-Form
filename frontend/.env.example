# Vite dev server → PHP API proxy (only used by `npm run dev`)
#
# Ampps default: Apache on port 80
VITE_API_PROXY_TARGET=http://127.0.0.1
#
# If PHP is NOT at the Apache docroot, set the folder path before /api
# Examples:
# VITE_API_PROXY_BASE=/Registration-System/public
#
# Production build: optional override (usually auto-detected from URL)
# VITE_API_BASE=/Registration-System/public
