# Dazu Hub Institute — environment configuration
# Copy to .env in project root (same level as app/ and public/ or dazuaihub.com/).

# Web URL prefix — leave empty when domain docroot IS the site folder (cPanel).
# Local Ampps: auto-detected from /Registration-System/public/...
# APP_WEB_ROOT=

# Filesystem web root — only if auto-detect is wrong (optional).
# APP_PUBLIC_ROOT=/home/dazutech/dazuaihub.com

# Database (cPanel: create DB + user in MySQL Databases)
# First run: php -S localhost:8000 router.php  then open http://localhost:8000/setup
DB_HOST=localhost
DB_NAME=registration_system
DB_USER=root
DB_PASS=mysql
